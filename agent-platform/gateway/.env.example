PORT=3001
# Bun HTTP idle timeout in seconds (default 10 is too low for streaming chat). Max 255.
GATEWAY_IDLE_TIMEOUT=120
AGENT_ENGINE_URL=http://localhost:8000

# Optional: leave blank to use built-in demo agents (no DB).
# Set both when you have run supabase/schema.sql.
SUPABASE_URL=
SUPABASE_ANON_KEY=
