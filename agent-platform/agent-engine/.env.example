# Required for Phase 1+ (LLM-powered agents)
OPENAI_API_KEY=sk-your-openai-key
# Optional — default primary model is gpt-5.2; fast lane default is gpt-4o-mini
# OPENAI_MODEL=gpt-5.2
# OPENAI_MODEL_FAST=gpt-4o-mini

# Optional: Supabase (agents/messages DB)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional: Google Sheets log (docs/google-sheets-crm.md)
# 1) Put service-account JSON in agent-engine folder as: google-sheets-credentials.json
# 2) Only this env required:
# GOOGLE_SHEETS_LOG_ID=spreadsheet_id_from_url
# Optional override path (else default file above):
# GOOGLE_SHEETS_CREDS_FILE=my-other.json
# Optional: Airtable instead or as well
# AIRTABLE_API_KEY=
# AIRTABLE_BASE_ID=
# AIRTABLE_LOG_TABLE=FrontDeskLogs

# Server
HOST=0.0.0.0
PORT=8000
